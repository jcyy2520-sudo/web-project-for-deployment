{
  "version": 2,
  "root": "web-frontend",
  "builds": [
    {
      "src": "web-frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "web-frontend/dist" }
    }
  ],
  "routes": [],
  "env": {
    "VITE_API_URL": "https://legaleaase.site/api"
  },
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist"
}
