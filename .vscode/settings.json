{
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/vendor/**": true,
    "**/storage/**": true,
    "**/.git/**": true,
    "**/dist/**": true,
    "**/public/storage/**": true,
    "**/web-backend/vendor/**": true,
    "**/web-backend/storage/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/vendor": true,
    "**/dist": true,
    "**/storage": true,
    "**/public/storage": true
  },
  "files.exclude": {
    "**/.cache": true,
    "**/node_modules": true,
    "**/vendor": true,
    "**/dist": true
  },
  "editor.largeFileOptimizations": true,
  "search.followSymlinks": false,
  "python.defaultInterpreterPath": "${workspaceFolder}\\\\.venv\\\\Scripts\\\\python.exe",
  "python.analysis.extraPaths": [
    "${workspaceFolder}\\\\ml-service"
  ]
}