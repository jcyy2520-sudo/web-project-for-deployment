# LLM Configuration for Smart Chatbot

# =============================================
# CLAUDE API (Anthropic) - Recommended
# =============================================
# Get your API key from: https://console.anthropic.com/account/keys
# Free tier: 5 requests/month
# Paid tier: ~$0.003 per request at scale

# Your Anthropic API key
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx

# Set to false to use Claude (default)
# Set to true to use Ollama instead
USE_OLLAMA_LLM=false


# =============================================
# OLLAMA (Self-Hosted) - Optional
# =============================================
# Only needed if USE_OLLAMA_LLM=true
# Install from: https://ollama.ai
# Pull model: ollama pull mistral

# Ollama server URL (localhost by default)
OLLAMA_API_URL=http://localhost:11434

# Model to use (mistral, llama2, neural-chat, etc.)
# Requires: ollama pull <model_name>
OLLAMA_MODEL=mistral


# =============================================
# LLM Settings
# =============================================

# Maximum tokens in response (increase for longer responses)
LLM_MAX_TOKENS=1024

# Temperature: 0.0-1.0 (0=deterministic, 1=creative)
LLM_TEMPERATURE=0.7

# Request timeout in seconds
LLM_REQUEST_TIMEOUT=30


# =============================================
# Chatbot Admin User (Optional)
# =============================================
# ID of user to represent the chatbot admin
# Leave empty to auto-detect first admin user
CHATBOT_ADMIN_USER_ID=

