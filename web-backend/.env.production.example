# ==========================================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ==========================================================
# Copy this file to .env on your production server
# NEVER commit .env files with real credentials to git!
# ==========================================================

# ==================== CRITICAL SECURITY SETTINGS ====================
# These MUST be set correctly for production!

APP_NAME="Your App Name"
APP_ENV=production
APP_KEY=base64:YOUR_GENERATED_KEY_HERE
APP_DEBUG=false
APP_URL=https://yourdomain.com

# ==================== CORS CONFIGURATION ====================
# Comma-separated list of allowed origins for CORS
# Include your frontend domain(s) here
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com,https://www.yourdomain.com

# ==================== DATABASE ====================
DB_CONNECTION=mysql
DB_HOST=your-database-host
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_database_user
DB_PASSWORD=your_secure_password

# ==================== SESSION & COOKIES ====================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.yourdomain.com
SESSION_SECURE_COOKIES=true
SESSION_SAME_SITE=lax

# ==================== CACHE & QUEUE ====================
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

# ==================== LOGGING ====================
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ==================== MAIL CONFIGURATION ====================
MAIL_MAILER=smtp
MAIL_HOST=smtp.your-email-provider.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# ==================== SECURITY FEATURES ====================
# IP whitelist for admin endpoints (comma-separated)
IP_WHITELIST_ENABLED=false
IP_WHITELIST=

# Two-Factor Authentication
TWO_FACTOR_ENABLED=true
TWO_FACTOR_ISSUER="${APP_NAME}"

# Bcrypt rounds (12 is good for production)
BCRYPT_ROUNDS=12

# ==================== API KEYS (if using AI features) ====================
# Only fill in what you need

# Claude (Anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ==================== CHATBOT SETTINGS ====================
CHATBOT_DEFAULT_PERSONALITY=professional
CHATBOT_MAX_CONTEXT_MESSAGES=50
CHATBOT_ENABLE_STREAMING=true
CHATBOT_ENABLE_RAG=true
CHATBOT_ENABLE_MEMORY=true

# ==================== IMPORTANT NOTES ====================
# 
# 1. Generate a new APP_KEY with: php artisan key:generate
# 
# 2. After deployment, run:
#    - php artisan config:cache
#    - php artisan route:cache
#    - php artisan view:cache
#    - php artisan migrate --force
#
# 3. Set up cron job for scheduler:
#    * * * * * cd /path-to-your-project && php artisan schedule:run >> /dev/null 2>&1
#
# 4. Set file permissions:
#    - chmod -R 755 storage bootstrap/cache
#    - chown -R www-data:www-data storage bootstrap/cache
#
# 5. Monitor with: php artisan system:health-check --json
