# Broadcast / Websockets example settings for local development
# Do NOT commit real secrets. Copy relevant values into your project's .env

# Use pusher driver (works with Pusher cloud or laravel-websockets local server)
BROADCAST_DRIVER=pusher

# Local Pusher-compatible settings (for laravel-websockets or testing)
PUSHER_APP_ID=local
PUSHER_APP_KEY=local-key
PUSHER_APP_SECRET=local-secret
PUSHER_APP_CLUSTER=mt1

# If running laravel-websockets locally, set host/port
PUSHER_APP_HOST=127.0.0.1
PUSHER_APP_PORT=6001
PUSHER_SCHEME=http

# Use sync queue for simple local development (no queue worker required)
QUEUE_CONNECTION=sync
