APP_NAME=Laravel
# CRITICAL: Set to 'production' when deploying to production server
# APP_ENV should NEVER be 'local' in production - it exposes debug info
APP_ENV=local
APP_KEY=
# CRITICAL: Set to 'false' in production - 'true' exposes sensitive stack traces
APP_DEBUG=false
APP_URL=http://localhost
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# ==================== SECURITY CONFIGURATION ====================
# IP whitelist for admin endpoints (comma-separated)
IP_WHITELIST_ENABLED=false
IP_WHITELIST=

# Two-Factor Authentication
TWO_FACTOR_ENABLED=false
TWO_FACTOR_ISSUER="${APP_NAME}"

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# CORS Configuration (production)
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jezee
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ==================== CHATBOT CONFIGURATION ====================
# Legacy HuggingFace Configuration (fallback)
HUGGINGFACE_API_KEY=

# ==================== ADVANCED LLM PROVIDERS ====================
# Configure at least one provider for production use

# Claude (Anthropic) - Recommended for best quality
# Get your API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620

# OpenAI - GPT-4 Alternative
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Mistral AI - Fast and cost-effective
# Get your API key from https://console.mistral.ai/
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# Ollama - Free local LLM (no API key needed)
# Install from https://ollama.ai/ and run: ollama pull llama2
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama2

# Provider priority (comma-separated, first available will be used)
# Options: claude, openai, mistral, ollama
LLM_PROVIDER_ORDER=claude,openai,mistral,ollama

# ==================== CHATBOT SETTINGS ====================
# Default personality: professional, friendly, expert, concise
CHATBOT_DEFAULT_PERSONALITY=professional
CHATBOT_MAX_CONTEXT_MESSAGES=50
CHATBOT_ENABLE_STREAMING=true
CHATBOT_ENABLE_RAG=true
CHATBOT_ENABLE_MEMORY=true

# ==================== EMBEDDINGS CONFIGURATION ====================
# For RAG (Retrieval Augmented Generation) and semantic search
# Options: openai, voyage, ollama
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# Voyage AI (alternative embedding provider)
# Get your API key from https://www.voyageai.com/
VOYAGE_API_KEY=

# ==================== REAL-TIME / WEBSOCKET ====================
# For real-time chat features (typing indicators, live streaming)
# Options: pusher, reverb, log (log = disabled)
BROADCAST_CONNECTION=log

# Pusher Configuration (or Laravel Reverb)
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# Frontend Pusher Keys (for JavaScript client)
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"


LLM_PRIMARY_PROVIDER=claude
LLM_PROVIDER_ORDER=claude,huggingface,openai,ollama
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here
HUGGINGFACE_API_KEY=your_huggingface_key_here

# ==================== GOOGLE OAUTH 2.0 CONFIGURATION ====================
# Get credentials from: https://console.cloud.google.com
# 1. Create a new project
# 2. Enable Google+ API
# 3. Create OAuth 2.0 credentials (Web application)
# 4. Add authorized redirect URIs:
#    - http://localhost:8000/auth/google/callback (local)
#    - https://yourdomain.com/auth/google/callback (production)
GOOGLE_CLIENT_ID=your_google_client_id_here
# IMPORTANT: If leaked, revoke the old secret in Google Cloud and generate a new one immediately.
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

